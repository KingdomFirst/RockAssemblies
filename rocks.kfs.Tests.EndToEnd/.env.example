# Copy to .env and fill in. .env is git-ignored -- never commit a real API key.
#
# The suite writes to the target site: it creates a test page, block, person, groups,
# connection type and workflow types, then deletes them afterwards. Point it at a
# beta/test site, never at a customer production site.

# Root URL of the Rock site under test (no trailing slash).
ROCK_BASE_URL=https://admin-rockbeta.kingdomfirstsolutions.com

# REST API key (Admin Tools > Security > REST Keys). The key's REST user must be able to
# create, edit and delete Pages, Blocks, Auths, People, Groups, GroupMembers, Attributes,
# AttributeValues, WorkflowTypes, Workflows and Connection entities. Adding the REST user to
# "RSR - Rock Administration" on the test site is the simplest way to do that.
ROCK_API_KEY=

# Id of an existing page to create the temporary test page under. Its layout is reused,
# so pick a page whose layout has a "Main" zone. Example: the parent of the beta site's
# page 773.
ROCK_TEST_PARENT_PAGE_ID=

# Zone to put the block in (optional, default Main).
ROCK_TEST_ZONE=Main

# Browser (optional). "msedge" or "chrome" uses the installed browser, so there is nothing
# to download. Use "chromium" only after running: npx playwright install chromium
BROWSER_CHANNEL=msedge

# --- Scheduled Group Communication (tests/Communication/ScheduledGroupCommunication) ---
# These tests send REAL messages. The test group's only member gets this email address and
# mobile number; use ones you can check.
# Email address to receive the test emails (check them in Edify > Dev > Messages > Outgoing).
SGC_TEST_EMAIL=
# 10-digit mobile number to receive the test texts.
SGC_TEST_SMS_NUMBER=
# Optional: sender address and name for the test emails (default: the site's Organization
# Email global attribute, and "KFS E2E Tests").
SGC_FROM_EMAIL=
SGC_FROM_NAME=
# Optional: the System Phone Number (Twilio) to send texts from, as its number or last digits
# (default: the first active, SMS-enabled System Phone Number).
SGC_SMS_FROM_NUMBER=

# --- Fundraising Participant Summary (tests/Fundraising/FundraisingParticipantSummary) ---
# These tests send REAL summary emails to the three test participants, all at this address
# (check them in Edify > Dev > Messages > Outgoing). Optional: defaults to SGC_TEST_EMAIL.
FPS_TEST_EMAIL=

# --- Eventbrite Sync (tests/Event/EventbriteSync) ---
# Optional: name of the hand-made Eventbrite test event (default "KFS E2E Test Event").
EVENTBRITE_TEST_EVENT_NAME=

# --- Custom Group Reminder (tests/Communication/CustomGroupReminder) ---
# These tests send a REAL reminder email and text. Optional: default to SGC_TEST_EMAIL and
# SGC_TEST_SMS_NUMBER.
CGR_TEST_EMAIL=
CGR_TEST_SMS_NUMBER=

# --- Microsoft 365 Utilities (tests/Communication/Microsoft365Utilities) ---
# The Microsoft 365 mailbox whose calendar (shortcode tests) and inbox (job test) are used:
# KFS uses the live calendar@ mailbox. The job test touches only the newest inbox email and puts
# its read/flag state back. M365_IMPERSONATE: the account with access to that mailbox.
M365_MAILBOX=
M365_IMPERSONATE=
# The same Azure app as the EWS global attributes, in plain text: the job test uses it to read
# and restore the email it touches. Update M365_APP_SECRET whenever the app's secret is renewed.
M365_APP_ID=
M365_TENANT_ID=
M365_APP_SECRET=
