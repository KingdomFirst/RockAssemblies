{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": [ "node" ]
    },
    "include": [ "playwright.config.ts", "shared/**/*.ts", "tests/**/*.ts" ]
}
